Bootstrap: docker
# condaforge/miniforge3 (ships mamba) confirmed available on Docker Hub.
#
# Switched from a pip+git install to bioconda 2026-09-18 after SIX real local
# build failures via `pip install git+https://github.com/mlbendall/telescope.git`
# exposed two independent, genuine problems in telescope's git-master source,
# not something fixable by tweaking this container alone:
#   1. setup.py's `cythonize(extensions)` call has no include_path, so Cython
#      can't resolve calignment.pyx's bare `cimport calignment` against its
#      own sibling calignment.pxd ("calignment.pxd not found") -- a packaging
#      bug, itself a known open upstream issue (mlbendall/telescope#57).
#   2. Once that's patched around, Cython then rejects the actual code on two
#      real semantic errors -- a `cpdef` method declared in the .pxd but never
#      defined in the .pyx, and an "undeclared name" on a plain Python import
#      referenced inside a cdef class property -- reproduced IDENTICALLY under
#      both Cython 0.29.36 and 3.3.0, so these are not a Cython-version
#      regression, they are real bugs in the current pip-installable source.
# Patching Cython-level semantic errors in someone else's compiled extension
# via sed, blind, is a correctness risk (silently-wrong locus assignment is
# exactly the kind of bug that would NOT announce itself later) -- not
# something to route around the same way as the include_path packaging bug.
# bioconda instead ships an actual prebuilt, tested package
# (bioconda.github.io/recipes/telescope/README.html) -- the maintainers' own
# environment.yml already implied conda, not pip+git, was the intended
# install path -- so this sidesteps the broken build entirely.
From: condaforge/miniforge3:latest

%labels
    maintainer  mwilde49
    description Telescope (locus-level HML-2/TE quantification, bioconda build) for virome-pipeline Telescope verification offshoot
    version     2.0.0

%post
    apt-get update -y && apt-get install -y --no-install-recommends procps \
        && rm -rf /var/lib/apt/lists/*

    # condaforge/miniforge3's BASE env pins python=3.14 (its own
    # /opt/conda/conda-meta/pinned, standard miniforge convention to keep
    # users from accidentally upgrading base) -- confirmed by a real build
    # failure, 2026-09-18: bioconda's telescope package only has builds for
    # Python 3.6-3.10, so `mamba install ... telescope` straight into base
    # can't solve. Fixed by creating a separate named env with an explicit
    # compatible Python instead (a fresh env has its own conda-meta, not
    # constrained by base's pin) -- python=3.10 matches one of the solver's
    # own reported viable combinations (telescope 1.0.3, python >=3.10,<3.11).
    #
    # click+pandas for the aggregation script baked in below (same pattern as
    # containers/pathseq.def); samtools kept for interactive BAM inspection
    # even though no module script here shells out to it directly.
    # numpy MUST be pinned <1.24 -- confirmed by a real synthetic-data run,
    # 2026-09-18: `telescope assign` got past BAM loading and alignment
    # scoring, then crashed building the likelihood model with
    # `AttributeError: module 'numpy' has no attribute 'int'`. Telescope's
    # own source (telescope/utils/model.py) uses the `np.int` alias, which
    # NumPy deprecated in 1.20 and removed outright in 1.24 -- bioconda's
    # telescope 1.0.3 recipe doesn't pin numpy tightly enough to avoid this
    # on its own, so it's pinned explicitly here instead.
    mamba create -y -n telescope -c bioconda -c conda-forge python=3.10 telescope samtools click pandas 'numpy<1.24' \
        && mamba clean -afy

    # Move the staged script into place now that the env's bin/ exists.
    # NOTE: %files runs BEFORE %post in Apptainer's build order (confirmed by
    # a real build failure, 2026-09-18: staging straight into
    # /opt/conda/envs/telescope/bin/ up front pre-created that path as a
    # stray non-conda file before `mamba create` ran, and mamba refused to
    # build into a prefix with existing non-conda content -- "Non-conda
    # folder exists at prefix - aborting"). Staging to a neutral path that
    # already exists in the base image sidesteps this ordering conflict.
    mv /opt/aggregate_telescope.py /opt/conda/envs/telescope/bin/aggregate_telescope.py
    chmod +x /opt/conda/envs/telescope/bin/aggregate_telescope.py

    # Patch a real, currently-unresolved upstream bug -- confirmed by the
    # TG12 pilot's real run, 2026-09-18 (job 411985): `telescope assign`
    # crashed ~4 minutes in with `ValueError: invalid literal for int() with
    # base 10: 'cached'`. Root cause verified directly against source
    # (telescope/utils/alignment.py, both the installed 1.0.3 and current git
    # master -- identical, unfixed either place): fetch_pairs_sorted()'s own
    # `#TODO: deal with these somehow` comment marks leftover read-pair mates
    # that never got matched within one per-chromosome-region processing pass
    # -- yielded with the placeholder string 'cached' instead of a numeric
    # alignment code, which model.py's _mapping_fromfiles() then can't
    # int()-parse. This is a known, open, zero-reply upstream issue
    # (mlbendall/telescope#9, filed Nov 2019). It is NOT a rare fluke here:
    # multi-mapping reads -- exactly what this offshoot turns on
    # (--outFilterMultimapNmax 100 etc.) -- commonly have one alignment
    # instance's mate land on a different chromosome than another instance's,
    # orphaning per-region cache entries at chromosome boundaries. Expect it
    # on every real multi-locus sample, not just this one.
    #
    # Patch: skip these leftover entries instead of yielding an unparseable
    # placeholder. Conservative by design -- this excludes a small,
    # upstream-author-acknowledged-ambiguous class of reads from the count
    # rather than crashing outright or inventing "correct" semantics the
    # maintainer never decided on themselves in 6+ years. Verified via
    # assert against the exact live-installed source text; build fails
    # loudly rather than silently no-op if bioconda's 1.0.3 source ever
    # differs from what was checked here.
    /opt/conda/envs/telescope/bin/python3 - <<'PYEOF'
import telescope.utils.alignment as m
path = m.__file__
old = """    for aln in readcache.values():
        #TODO: deal with these somehow
        yield ('cached', AlignedPair(aln))
"""
new = """    # PATCHED (TJP lab, 2026-09-18) -- see containers/telescope.def.
    # Upstream (mlbendall/telescope#9, open since 2019) yields these with an
    # unparseable 'cached' placeholder that crashes model.py's
    # _mapping_fromfiles(). Skipped instead of yielded.
    pass
"""
text = open(path).read()
assert old in text, (
    f"telescope.def patch target not found verbatim in {path} -- "
    f"upstream source changed, re-verify against mlbendall/telescope#9 "
    f"before assuming this is still needed or still correct."
)
open(path, 'w').write(text.replace(old, new))
print(f"Patched {path}: leftover cached-mate entries now skipped instead of crashing")
PYEOF

%files
    # Pipeline script baked in at build time.
    # Always run apptainer build from the repo root.
    bin/aggregate_telescope.py  /opt/aggregate_telescope.py

%environment
    export LC_ALL=C
    # No `conda activate` machinery -- the telescope env's bin dir is just
    # prepended to PATH, so `telescope`/`samtools`/`python3` (with
    # click+pandas installed) all resolve from it directly under `apptainer
    # exec`, which doesn't source conda's activation hooks.
    export PATH=/opt/conda/envs/telescope/bin:$PATH

%test
    telescope --version
    telescope assign --help 2>&1 | head -5
    samtools --version | head -1
    python3 -c "import pysam, numpy, scipy, click, pandas; print('Python deps OK')"
    aggregate_telescope.py --help
