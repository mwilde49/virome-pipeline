/*
 * conf/slurm.config — SLURM executor settings for Juno HPC
 */

process {
    executor     = 'slurm'
    queue        = 'normal'
    // juno-pri (2026-08-19): elevated-priority QOS granted by the Juno team
    // after reporting the concurrent-job ceiling hit under 'normal'.
    // MaxJobsPerUser=8 (hard cap, running+pending), MaxSubmitJobsPerUser=150.
    // Confirmed via `sacctmgr show qos` (juno-pri|8|150|) even before it was
    // known to apply to this account -- 8 is a TIGHTER concurrent cap than
    // the ~24-25 empirically found under 'normal', so queueSize needed
    // lowering further, not raising, despite this being framed as an
    // upgrade -- the actual benefit is scheduling priority (faster dispatch
    // once a slot is used), not a bigger slot count.
    clusterOptions = '--account=tprice --qos=juno-pri'

    // Load apptainer and emit SLURM job ID for monitoring
    beforeScript = 'module load apptainer && echo "SLURM_JOB_ID: $SLURM_JOB_ID"'
}

executor {
    name           = 'slurm'
    // queueSize=10 + the head job itself (also --qos=juno-pri, see
    // scripts/run_virome_config.sbatch) = 11 attempted concurrent -- ABOVE
    // juno-pri's hard MaxJobsPerUser=8, by design choice (2026-08-19). At
    // most 7 of these 10 will ever actually run at once; the remaining
    // ~2-3 sit as harmless QOSMaxJobsPerUserLimit backpressure (a wait
    // state, not the harder QOSMaxSubmitJobPerUserLimit rejection that
    // killed runs earlier) rather than adding real throughput past 7. Set
    // this way deliberately rather than capped at 7 -- if that's not
    // actually wanted, 7 is the value that uses the full QOS allowance with
    // zero wasted/blocked submission attempts.
    queueSize      = 10       // max concurrent jobs submitted at once
    pollInterval   = '30 sec'
    submitRateLimit = '10/1min'
}
