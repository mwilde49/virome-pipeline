/*
 * conf/slurm.config — SLURM executor settings for Juno HPC
 */

process {
    executor     = 'slurm'
    queue        = 'normal'
    clusterOptions = '--account=tprice'

    // Load apptainer and emit SLURM job ID for monitoring
    beforeScript = 'module load apptainer && echo "SLURM_JOB_ID: $SLURM_JOB_ID"'
}

executor {
    name           = 'slurm'
    // Real-world ceiling found 2026-08-19: a single cohort (Watchmaker, 24
    // samples) alone hit QOSMaxJobsPerUserLimit at ~24-25 concurrent
    // running+pending jobs (account/partition-level limit, not visible via
    // `sacctmgr show qos`/`show assoc` -- neither showed any configured
    // number, so this ceiling is set elsewhere, likely slurm.conf itself).
    // Running two cohorts concurrently at the old queueSize=50 additionally
    // hit the harder QOSMaxSubmitJobPerUserLimit (an outright submission
    // rejection, fatal to Nextflow, unlike QOSMaxJobsPerUserLimit which just
    // queues and waits). Lowered well under the observed ceiling, leaving
    // headroom for the head job itself plus any residual jobs from a prior
    // run not yet fully cleared.
    queueSize      = 15       // max concurrent jobs submitted at once
    pollInterval   = '30 sec'
    submitRateLimit = '10/1min'
}
