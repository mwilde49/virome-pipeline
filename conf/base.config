/*
 * conf/base.config — per-process resource allocations
 */

process {

    // Defaults
    cpus        = 2
    memory      = '8.GB'
    time        = '4.h'
    stageInMode = 'copy'

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withName: 'FASTQC' {
        cpus   = 4
        memory = '8.GB'
        time   = '2.h'
    }

    withName: 'TRIMMOMATIC' {
        cpus   = 8
        memory = '16.GB'
        time   = '12.h'  // donor1-L5 has 174M reads
    }

    withName: 'STAR_HOST_REMOVAL' {
        cpus        = 16
        memory      = '64.GB'
        time        = '24.h'  // donor1-L5 has 174M reads
        stageInMode = 'symlink'  // STAR index is 33 GB — symlink, not copy
    }

    withName: 'KRAKEN2_CLASSIFY' {
        cpus        = 16
        memory      = { 64.GB * task.attempt }  // scale on OOM retry
        time        = '12.h'
        stageInMode = 'symlink'  // viral DB is 1.1 GB; symlink + autoMounts, no copy
    }

    withName: 'KRAKEN2_CLASSIFY_DB2' {
        cpus        = 16
        memory      = { 110.GB * task.attempt }  // PlusPF hash.k2d is 87 GB
        time        = '12.h'
        stageInMode = 'symlink'  // PlusPF DB is 87 GB — must not copy
    }

    withName: 'BRACKEN' {
        cpus        = 4
        memory      = '16.GB'
        time        = '2.h'
        stageInMode = 'symlink'  // DB shared with KRAKEN2_CLASSIFY; avoid redundant copy
    }

    withName: 'BRACKEN_DB2' {
        cpus        = 4
        memory      = '16.GB'
        time        = '2.h'
        stageInMode = 'symlink'
    }

    withName: 'KRAKEN2_FILTER' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }

    withName: 'AGGREGATE' {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
    }

    withName: 'MULTIQC' {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
    }

    withName: 'REPORT' {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
    }

    withName: 'EXTRACT_KRAKEN2_READS' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }

    withName: 'BLAST_VERIFY' {
        cpus   = 8
        memory = '32.GB'   // nt database is large; keep in memory for speed
        time   = '4.h'
        stageInMode = 'symlink'  // blast_db_dir can be 100+ GB; never copy
    }

    withName: 'BLAST_ANALYZE' {
        cpus   = 4
        memory = '8.GB'
        time   = '1.h'
    }

    withName: 'DEDUP_FILTER_HOST' {
        cpus   = 8
        memory = '16.GB'
        time   = '4.h'
    }

    withName: 'FEATURECOUNTS' {
        cpus   = 8
        memory = '32.GB'  // GTF (GENCODE, ~1.8GB) parsed once across all sample BAMs
        time   = '4.h'
    }

    withName: 'HTSEQ_COUNT' {
        cpus   = 2   // htseq-count is single-threaded
        memory = '16.GB'
        time   = '8.h'  // htseq is slow relative to featureCounts
    }

    withName: 'AGGREGATE_HOST_COUNTS' {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
    }

    withName: 'FASTQ_TO_UBAM' {
        // Picard FastqToSam just interleaves/tags reads into an unaligned BAM —
        // no alignment, no sorting-by-coordinate. donor1-L5 (this pipeline's
        // largest documented sample, 174M read pairs, see TRIMMOMATIC/
        // STAR_HOST_REMOVAL above) is comfortably within 8 GB/4 h for this
        // class of operation; STAR_HOST_REMOVAL itself only needs 64 GB/24 h
        // for full splice-aware alignment on the same reads.
        cpus   = 2
        memory = '8.GB'
        time   = '4.h'
    }

    withName: 'PATHSEQ_SCORE' {
        // PathSeqPipelineSpark is by far the heaviest process in the pipeline.
        // Broad's own WDL resource table: filter step 32 GB/8cpu, align step
        // 140 GB/8cpu (BWA-MEM vs. the 94.6 GB microbe bundle), score step
        // 8 GB/2cpu. We skip the filter step (input is pre-host-depleted), but
        // still pay the align+score cost in one Spark local[*] process.
        // A real-world Biostars report (biostars.org/p/9603549, "Performance
        // Issues with GATK4 PathSeqPipelineSpark on 35bp Bulk-RNA Unmapped
        // Reads") ran PathSeqPipelineSpark on this pipeline's exact data shape
        // (short-read bulk-RNA STAR-unmapped reads) and needed 200 GB heap and
        // was still slow. Set generously above that ceiling and give it a long
        // wall-clock allowance rather than risk a late-stage OOM/timeout kill
        // after hours of alignment work.
        cpus        = 32
        memory      = '200.GB'
        time        = '48.h'
        stageInMode = 'symlink'  // microbe BWA image is ~94.6 GB — never copy
    }

    withName: 'CAPTURE_SOFTWARE_VERSIONS' {
        // No `container` directive on this process (see module header) --
        // it shells out to `apptainer exec` against each of this run's own
        // containers itself, sequentially. Modest resources; the dominant
        // cost is apptainer's per-container cold-start overhead, not compute.
        cpus   = 1
        memory = '4.GB'
        time   = '1.h'
    }

    withName: 'AGGREGATE_PATHSEQ' {
        cpus   = 2
        memory = '8.GB'
        time   = '1.h'
        // stageInMode intentionally left at the process-block default ('copy'),
        // NOT overridden to 'symlink' — unlike BLAST_VERIFY's blast_db_dir (a
        // single large EXTERNAL reference path), this process's primary input
        // (scores_files, the collected PATHSEQ_SCORE.out.scores from every
        // sample) is made of per-task outputs living in THIS SAME RUN's own
        // hashed workDir subdirectories. stageInMode applies to every path
        // input on a process, so overriding it here for the optional
        // blast_lifecycle_dir would also force symlink staging onto
        // scores_files — exactly the "symlinks across work directories"
        // failure mode Apptainer's --cleanenv cannot follow (see CLAUDE.md's
        // Architecture section). AGGREGATE and AGGREGATE_HOST_COUNTS, the two
        // other aggregation steps that collect() intra-run per-sample outputs,
        // both correctly leave this at 'copy' — match that precedent here too.
    }
}
