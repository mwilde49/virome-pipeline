/*
 * Virome Pipeline — nextflow.config
 * Global parameters and profile definitions.
 */

manifest {
    name        = 'virome'
    description = 'Systematic profiling of the human DRG virome from bulk RNA-seq data'
    version     = '2.0.0'
    nextflowVersion = '>=23.04.0'
}

// ---------------------------------------------------------------------------
// Default parameters (all overridable via config.yaml or --param CLI flags)
// ---------------------------------------------------------------------------
params {

    // --- Required ---
    samplesheet = null
    outdir      = null

    // --- References ---
    star_index   = null   // path to pre-built STAR index (GRCh38)
    kraken2_db   = null   // path to Kraken2 viral database

    // --- Trimmomatic ---
    adapters         = "${projectDir}/assets/NexteraPE-PE.fa"
    trim_leading     = 3
    trim_trailing    = 3
    trim_slidingwindow = '4:15'
    trim_minlen      = 36
    trim_headcrop    = 0

    // --- Host removal (STAR) ---
    star_extra_args  = ''

    // --- Kraken2 ---
    kraken2_confidence  = 0.1
    kraken2_extra_args  = ''

    // --- Bracken ---
    bracken_read_length = 150   // match your sequencing read length (50/75/100/150/200/250/300)
    bracken_level       = 'S'   // taxonomic level: S=species, G=genus
    bracken_threshold   = 10    // min reads required to re-estimate abundance

    // --- Filtering ---
    min_reads_per_taxon = 5    // minimum read count to retain a taxon per sample
    artifact_list       = "${projectDir}/assets/artifact_taxa.tsv"  // set to null to disable
    taxon_remap         = "${projectDir}/assets/taxon_remap.tsv"    // set to null to disable

    // --- Dual-database comparison (optional) ---
    // Set kraken2_db2 to a PlusPF or standard Kraken2 DB path to run a parallel
    // classification branch. Produces a consensus matrix (taxa detected in both
    // databases) and a false-positive candidate list (taxa in viral-only only).
    // Leave null for single-DB mode (default behavior, no change to outputs).
    kraken2_db2         = null

    // --- Host gene expression quantification (optional) ---
    // Set run_host_quant = true to dedup/filter and dually quantify (featureCounts
    // + HTSeq) the GRCh38-mapped reads that STAR_HOST_REMOVAL currently discards,
    // producing host_gene_expression_matrix.tsv normalized on the same STAR
    // input-read denominator as the viral matrices (directly comparable RPM).
    // Requires gtf, blacklist_bed, exclude_bed. Leave false for no change to
    // existing outputs/runtime.
    run_host_quant      = false
    gtf                 = null   // GENCODE/Ensembl GTF, GRCh38 (e.g. gencode.v48.primary_assembly.annotation.gtf)
    blacklist_bed       = null   // ENCODE blacklist regions
    exclude_bed         = null   // additional exclude regions (rRNA, etc.)
    gene_info           = "${projectDir}/assets/gene_id_name_biotype.tsv"  // set to null to disable
    htseq_strand        = 'reverse'  // htseq-count -s: yes/no/reverse
    htseq_paired_order   = 'pos'     // htseq-count -r: name/pos (must match BAM sort order)

    // --- Containers ---
    container_dir = '/groups/tprice/pipelines/containers/virome'

    // --- PathSeq (optional validation) ---
    run_pathseq      = false
    pathseq_microbe_bwa_image = null
    pathseq_microbe_fasta     = null
    pathseq_taxonomy          = null

    // --- PathSeq verification offshoot (pathseq_verify.nf) ---
    // consensus_matrix and target_taxa are NOT redeclared here — they already exist
    // as undeclared/dynamic params consumed by workflows/blast_verification.nf's
    // get_target_taxa() (set via -params-file, e.g. assets/config_blast_pd19.yaml)
    // and pathseq_verify.nf reuses the exact same two param names for the exact
    // same purpose. blast_lifecycle_dir is new: optional dir of BLAST offshoot
    // lifecycle_inference.tsv outputs, joined into the PathSeq concordance table
    // when present. Leave null to skip the three-way join (PathSeq-vs-consensus
    // two-way concordance only).
    blast_lifecycle_dir = null

    // --- MultiQC ---
    multiqc_config   = null
    multiqc_title    = 'Virome Pipeline QC Report'
}

// ---------------------------------------------------------------------------
// Configuration profiles
// ---------------------------------------------------------------------------
profiles {

    slurm {
        includeConfig 'conf/slurm.config'
        workDir = "/scratch/juno/${System.getenv('USER')}/nf_work"
    }

    standard {
        process.executor = 'local'
    }

    test {
        includeConfig 'conf/test.config'
    }
}

// ---------------------------------------------------------------------------
// Base resource defaults (overridden per-process in conf/base.config)
// ---------------------------------------------------------------------------
includeConfig 'conf/base.config'

// ---------------------------------------------------------------------------
// Apptainer settings
// ---------------------------------------------------------------------------
apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '--cleanenv'
}

// ---------------------------------------------------------------------------
// Execution reports
// ---------------------------------------------------------------------------
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.tsv"
    overwrite = true
    fields    = 'task_id,process,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,vol_ctxt,inv_ctxt'
}
